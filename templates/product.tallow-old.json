    "mm_pdp_ba_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-principle\">\n  \n  <h2 class=\"mm-pdp-principle-title\">Bereits nach wenigen Anwendungen sichtbare Ergebnisse</h2>\n  <p class=\"mm-pdp-principle-sub\">Tallow – Reduziert auf das Wesentliche.</p>\n\n<div class=\"mm-pdp-ba mm-pdp-ba--wide\" data-mm-ba>\n  <span class=\"mm-pdp-ba-label mm-pdp-ba-label--before\">Vorher</span>\n  <span class=\"mm-pdp-ba-label mm-pdp-ba-label--after\">Nachher</span>\n  <div class=\"mm-pdp-ba-after\" data-mm-ba-after>\n    <img src=\"https://menmansion.com/cdn/shop/files/hf_20260606_090217_e15e0f3d-f156-48d5-93a1-298106f554ad.png?v=1780736665&width=900\" alt=\"Nachher: Haut nach Tallow Gesichtscreme\" draggable=\"false\">\n  </div>\n  <div class=\"mm-pdp-ba-before\" data-mm-ba-before>\n    <img src=\"https://menmansion.com/cdn/shop/files/hf_20260606_081846_2e8192e0-9957-4ac1-9501-81532cf094df.png?v=1780735741&width=900\" alt=\"Vorher: Haut ohne Tallow Gesichtscreme\" draggable=\"false\">\n  </div>\n  <div class=\"mm-pdp-ba-handle\" data-mm-ba-handle>\n    <span class=\"mm-pdp-ba-handle-grip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M5 4L1 8L5 12\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M11 4L15 8L11 12\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n  </div>\n</div>\n\n  <div class=\"mm-pdp-principle-grid mm-pdp-principle-grid--4\">\n    <div class=\"mm-pdp-principle-card\">\n      <img class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" src=\"https://menmansion.com/cdn/shop/files/Naturlich-Icon.svg?v=1766148057\" alt=\"\">\n      <h4 class=\"mm-pdp-principle-card-title\">Zieht komplett ein</h4>\n      <p class=\"mm-pdp-principle-card-text\">Ohne Fettfilm und ohne Rückstände auf der Haut.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <img class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" src=\"https://menmansion.com/cdn/shop/files/Haut.svg?v=1766157612\" alt=\"\">\n      <h4 class=\"mm-pdp-principle-card-title\">Perfekte Formel</h4>\n      <p class=\"mm-pdp-principle-card-text\">Feuchtigkeit, Aufbau und Geschmeidigkeit in einem.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <img class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" src=\"https://menmansion.com/cdn/shop/files/Skin.svg?v=1766157611\" alt=\"\">\n      <h4 class=\"mm-pdp-principle-card-title\">Reich an Nährstoffen</h4>\n      <p class=\"mm-pdp-principle-card-text\">Vitamin A, D, E und K aus dem Rindertalg.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <img class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" src=\"https://menmansion.com/cdn/shop/files/Lorbeer.svg?v=1766080022\" alt=\"\">\n      <h4 class=\"mm-pdp-principle-card-title\">Traditionelle Basis</h4>\n      <p class=\"mm-pdp-principle-card-text\">Rezeptur nach alter&nbsp;Überlieferung.</p>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_ingredients_section": {
      "type": "custom-liquid",
      "name": "MM Inhaltsstoffe (Raster)",
      "settings": {
        "custom_liquid": "{{ 'mm-pdp-ingredients-grid.css' | asset_url | stylesheet_tag }}\n<section class=\"mm-ig\">\n  <div class=\"mm-ig-inner\">\n\n    <header class=\"mm-ig-head\">\n      <h2 class=\"mm-ig-title\">100 % natürliche Inhaltsstoffe</h2>\n      <p class=\"mm-ig-eyebrow\">Die Magie dahinter. Reduziert auf das Wesentliche</p>\n    </header>\n\n  <ul class=\"mm-ig-grid\">\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/35.jpg?v=1786099583&width=600\" alt=\"Tallow\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Tallow</h3>\n        <p class=\"mm-ig-benefit\">Enthält alle Nährstoffe und Vitamine die deine Haut benötigt.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/gemini-image-2_Create_a_cinematic_macro_scene_featuring_grape_seed_oil_as_the_central_ingredien-2_2.jpg?v=1786099586&width=600\" alt=\"Traubenkernöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Traubenkernöl</h3>\n        <p class=\"mm-ig-benefit\">Zieht leicht ein und sorgt für ein geschmeidiges Hautgefühl.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/Lucid_Realism_Hyperrealistic_macro_shot_of_black_cumin_oil_Nig_0_1.jpg?v=1786099587&width=600\" alt=\"Schwarzkümmelöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Schwarzkümmelöl</h3>\n        <p class=\"mm-ig-benefit\">Wirkt antibakteriell, stärkt die Haut und beruhigt Unreinheiten.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/IMG_0327.jpg?v=1786099586&width=600\" alt=\"Bienenwachs\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Bienenwachs</h3>\n        <p class=\"mm-ig-benefit\">Schützt die Haut und hält sie langanhaltend geschmeidig.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/results-driven_backed_by_science_formulated_for_all_skin_types______discover_our_range_of_powerful_serums_today_23648c38-f789-42fc-93de-16cdf40aa351.jpg?v=1786099584&width=600\" alt=\"Squalan\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Squalan</h3>\n        <p class=\"mm-ig-benefit\">Zieht schnell ein und hinterlässt ein glattes Hautgefühl.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/ChatGPT_Image_10._Aug._2026_10_29_08.png?v=1786350590&width=600\" alt=\"Cetylalkohol\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Cetylalkohol</h3>\n        <p class=\"mm-ig-benefit\">Pflanzlicher Konsistenzgeber für eine cremige Textur.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/ChatGPT_Image_10._Aug._2026_10_26_18.png?v=1786350395&width=600\" alt=\"Zedernholzöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Zedernholzöl</h3>\n        <p class=\"mm-ig-benefit\">Verleiht der Creme ihren edlen, maskulinen Duft nach Zedernholz.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/Bergamot_lends_a_fresh_elevated_edge__Bright_refined_effortlessly_premium.jpg?v=1786099583&width=600\" alt=\"Bergamotte\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Bergamotte</h3>\n        <p class=\"mm-ig-benefit\">Frische Kopfnote der Duftkomposition. Dezent statt parfümiert.</p>\n      </div>\n    </li>\n  </ul>\n\n  </div>\n</section>",
