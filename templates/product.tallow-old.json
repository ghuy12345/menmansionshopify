        "custom_liquid_nPaeiV": {
          "type": "custom_liquid",
          "name": "Customer Needs",
          "settings": {
            "custom_liquid": "<div class=\"mm-skin-types\">\n  <p class=\"mm-skin-types__label\">Geeignet für:</p>\n  <div class=\"mm-skin-types__grid\">\n    <div class=\"mm-skin-types__item\">\n      <div class=\"mm-skin-types__icon\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/NORMALE_HAUT.svg?v=1774872404\" alt=\"Normale Haut\" />\n      </div>\n      <span class=\"mm-skin-types__text\">Normale Haut</span>\n    </div>\n    <div class=\"mm-skin-types__item\">\n      <div class=\"mm-skin-types__icon\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/TROCKENE_HAUT.svg?v=1774872404\" alt=\"Trockene Haut\" />\n      </div>\n      <span class=\"mm-skin-types__text\">Trockene Haut</span>\n    </div>\n    <div class=\"mm-skin-types__item\">\n      <div class=\"mm-skin-types__icon\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/UNREINE_HAUT.svg?v=1774872405\" alt=\"Unreine Haut\" />\n      </div>\n      <span class=\"mm-skin-types__text\">Unreine Haut</span>\n    </div>\n  </div>\n</div>\n<style>\n  .mm-skin-types {\n    padding: 8px 0 8px;\n    border-top: 1px solid rgba(175, 152, 65, 0.2);\n    margin-top: 2px;\n  }\n  .mm-skin-types__label {\n    font-size: 12px;\n    letter-spacing: 0.12em;\n    color: #FAFAF8;\n    margin: 0 0 12px 0;\n    font-weight: 900;\n  }\n  .mm-skin-types__grid {\n    display: flex;\n    gap: 0;\n    align-items: flex-start;\n  }\n  .mm-skin-types__item {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    padding: 0 8px;\n    border-right: 1px solid rgba(255, 255, 255, 0.08);\n  }\n  .mm-skin-types__item:last-child {\n    border-right: none;\n  }\n  .mm-skin-types__icon {\n    width: 60px;\n    height: 60px;\n  }\n  .mm-skin-types__icon img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n  }\n  .mm-skin-types__text {\n    font-size: 11px;\n    color: #FAFAF8;\n    text-align: center;\n    letter-spacing: 0.04em;\n    line-height: 1.3;\n  }\n</style>"
