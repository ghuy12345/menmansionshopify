        "custom_liquid": "<div class=\"mm-pdp-studie\">\n  \n  <h2 class=\"mm-pdp-studie-title\">Bewiesene Wirkung,<br><span class=\"mm-pdp-gold\">sichtbare Ergebnisse</span></h2>\n  <div class=\"mm-pdp-studie-stats\">\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">92%</div>\n      <div class=\"mm-pdp-studie-desc\">Sichtbar glattere Haut nach 7 Tagen</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">96%</div>\n      <div class=\"mm-pdp-studie-desc\">Sofort weniger Trockenheit</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">97%</div>\n      <div class=\"mm-pdp-studie-desc\">Würden die Creme weiterempfehlen</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n  </div>\n</div>",
