      "settings": {
        "custom_liquid": "{{ 'mm-pdp-testimonials.css' | asset_url | stylesheet_tag }}\n<section class=\"mm-tst\">\n  <div class=\"mm-tst-inner\">\n\n    <header class=\"mm-tst-head\">\n      <h2 class=\"mm-tst-title\">Das sagen unsere Gentleman</h2>\n    </header>\n\n    <ol class=\"mm-tst-rail\" id=\"mm-tst-rail\">\n\n      <li class=\"mm-tst-card\" data-mm-tst-video>\n        <div class=\"mm-tst-media\">\n          <video preload=\"none\" muted playsinline loop\n                 poster=\"https://menmansion.com/cdn/shop/files/IMG_2576.jpg?v=1780737420&width=700\"\n                 data-src=\"https://menmansion.com/cdn/shop/videos/c/vp/bbfa673ff1664537af2ce80369e71c41/bbfa673ff1664537af2ce80369e71c41.HD-1080p-7.2Mbps-85852471.mp4\"></video>\n          <img class=\"mm-tst-poster\" src=\"https://menmansion.com/cdn/shop/files/IMG_2576.jpg?v=1780737420&width=700\" alt=\"Rocco, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n          <button type=\"button\" class=\"mm-tst-play\" aria-label=\"Video von Rocco abspielen\">\n            <svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 2.5v11l9-5.5-9-5.5Z\"/></svg>\n          </button>\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Ich seh um 10 Jahre jünger aus! Und das nur wegen dieser einen Creme.“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Rocco</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"mm-tst-card\" data-mm-tst-video>\n        <div class=\"mm-tst-media\">\n          <video preload=\"none\" muted playsinline loop\n                 poster=\"https://menmansion.com/cdn/shop/files/IMG_2578.jpg?v=1780737581&width=700\"\n                 data-src=\"https://menmansion.com/cdn/shop/videos/c/vp/4aad8f96b2fc49fa89c0760d436bff7a/4aad8f96b2fc49fa89c0760d436bff7a.HD-1080p-7.2Mbps-85852748.mp4\"></video>\n          <img class=\"mm-tst-poster\" src=\"https://menmansion.com/cdn/shop/files/IMG_2578.jpg?v=1780737581&width=700\" alt=\"Markus, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n          <button type=\"button\" class=\"mm-tst-play\" aria-label=\"Video von Markus abspielen\">\n            <svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 2.5v11l9-5.5-9-5.5Z\"/></svg>\n          </button>\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Eine Woche! Und ich war geschockt von den Ergebnissen.“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Markus</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"mm-tst-card\" data-mm-tst-video>\n        <div class=\"mm-tst-media\">\n          <video preload=\"none\" muted playsinline loop\n                 poster=\"https://menmansion.com/cdn/shop/files/Neueste_Fotos_anzeigen_5.png?v=1774878225&width=700\"\n                 data-src=\"https://menmansion.com/cdn/shop/videos/c/vp/d8c85ac160da4e3fad95c79867533536/d8c85ac160da4e3fad95c79867533536.HD-1080p-7.2Mbps-79815517.mp4\"></video>\n          <img class=\"mm-tst-poster\" src=\"https://menmansion.com/cdn/shop/files/Neueste_Fotos_anzeigen_5.png?v=1774878225&width=700\" alt=\"Ebi, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n          <button type=\"button\" class=\"mm-tst-play\" aria-label=\"Video von Ebi abspielen\">\n            <svg viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M4 2.5v11l9-5.5-9-5.5Z\"/></svg>\n          </button>\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Ich war immer skeptisch was Skincare Produkte angeht, aber das hier ist wirklich anders! Super angenehm auf der Haut, zieht schnell ein und riecht edel.“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Ebi</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"mm-tst-card\">\n        <div class=\"mm-tst-media\">\n          <img src=\"https://menmansion.com/cdn/shop/files/0002-8194805062219929543.png?v=1780739071&width=700\" alt=\"Tobias, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Textur und Duft sind fantastisch! Ich bin 45 und meine Haut hat wieder ihre Frische und ihren Glanz bekommen, den sie noch vor 10 Jahren hatte!“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Tobias</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"mm-tst-card\">\n        <div class=\"mm-tst-media\">\n          <img src=\"https://menmansion.com/cdn/shop/files/IMG_2572.jpg?v=1780737133&width=700\" alt=\"Thomas, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Meine Haut hat einen richtig gesunden Glow bekommen, meine Frau liebt’s. Bleibe dabei.“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Thomas</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      <li class=\"mm-tst-card\">\n        <div class=\"mm-tst-media\">\n          <img src=\"https://menmansion.com/cdn/shop/files/0003-1890891485917242492.png?v=1780739476&width=700\" alt=\"Can, Kunde von Men Mansion\" loading=\"lazy\" width=\"700\" height=\"613\">\n        </div>\n        <div class=\"mm-tst-body\">\n          <span class=\"mm-tst-stars\" aria-label=\"5 von 5 Sternen\">★★★★★</span>\n          <p class=\"mm-tst-quote\">„Meine Haut fühlt sich deutlich frischer und glatter an und dieser leichte Glanz hält über den ganzen Tag. Mega!“</p>\n          <div class=\"mm-tst-foot\">\n            <span class=\"mm-tst-name\">Can</span>\n            <span class=\"mm-tst-verified\"><svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Verifiziert</span>\n          </div>\n        </div>\n      </li>\n\n      \n    </ol>\n\n    <div class=\"mm-tst-nav\" id=\"mm-tst-nav\">\n      <div class=\"mm-tst-arrows\">\n        <button type=\"button\" class=\"mm-tst-arrow\" data-mm-tst-prev aria-label=\"Vorherige Stimme\">\n          <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M10 3L5 8l5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </button>\n        <button type=\"button\" class=\"mm-tst-arrow\" data-mm-tst-next aria-label=\"Naechste Stimme\">\n          <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 3l5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        </button>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  var rail = document.getElementById('mm-tst-rail');\n  if (!rail) return;\n  var cards = Array.prototype.slice.call(rail.children);\n  var nav = document.getElementById('mm-tst-nav');\n  var prev = document.querySelector('[data-mm-tst-prev]');\n  var next = document.querySelector('[data-mm-tst-next]');\n  var total = cards.length;\n\n  // Striche wie in Bestseller und Routine: einer pro Karte, klickbar\n  function step() {\n    return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : cards[0].offsetWidth;\n  }\n\n  // Es sind mehrere Karten gleichzeitig sichtbar, der Scroll endet also vor der\n  // letzten Karte. Ohne diese Grenze gab es Striche, die nie aktiv werden, und\n  // der Pfeil lief am Ende ins Leere statt umzubrechen.\n  function maxIndex() {\n    var s = step();\n    if (!s) return 0;\n    return Math.max(0, Math.min(total - 1, Math.round((rail.scrollWidth - rail.clientWidth) / s)));\n  }\n\n  function index() {\n    var s = step();\n    if (!s) return 0;\n    return Math.max(0, Math.min(maxIndex(), Math.round(rail.scrollLeft / s)));\n  }\n\n  function scrollToCard(i, behavior) {\n    var el = cards[i];\n    if (el) rail.scrollTo({ left: el.offsetLeft - rail.offsetLeft, behavior: behavior || 'smooth' });\n  }\n\n  // Striche: einer pro anfahrbarer Position, vor der Pfeil-Gruppe und in\n  // aufsteigender Reihenfolge. Bei Resize aendert sich die Zahl, also neu bauen.\n  var dots = [];\n  var arrowsBox = nav ? nav.querySelector('.mm-tst-arrows') : null;\n  function buildDots() {\n    if (!nav) return;\n    for (var r = 0; r < dots.length; r++) {\n      if (dots[r].parentNode) dots[r].parentNode.removeChild(dots[r]);\n    }\n    dots = [];\n    var n = maxIndex() + 1;\n    for (var d = 0; d < n; d++) {\n      var b = document.createElement('button');\n      b.type = 'button';\n      b.className = 'mm-tst-dot';\n      b.setAttribute('aria-label', 'Stimme ' + (d + 1));\n      b.dataset.i = d;\n      b.appendChild(document.createElement('span'));\n      b.addEventListener('click', function () { scrollToCard(+this.dataset.i, 'smooth'); });\n      if (arrowsBox) nav.insertBefore(b, arrowsBox);\n      else nav.appendChild(b);\n      dots.push(b);\n    }\n  }\n\n  function sync() {\n    var i = index();\n    for (var n = 0; n < dots.length; n++) {\n      dots[n].setAttribute('aria-current', n === i ? 'true' : 'false');\n    }\n    // Kein disabled an den Raendern: der Slider laeuft im Kreis.\n  }\n\n  function go(dir) {\n    if (!step()) return;\n    var max = maxIndex();\n    var t = index() + dir;\n    var wrapped = false;\n    if (t < 0) { t = max; wrapped = true; }\n    else if (t > max) { t = 0; wrapped = true; }\n    // Beim Umbruch hart springen, smooth wuerde sichtbar durch alle Karten scrollen.\n    scrollToCard(t, wrapped ? 'auto' : 'smooth');\n  }\n\n  buildDots();\n  if (prev) prev.addEventListener('click', function () { go(-1); });\n  if (next) next.addEventListener('click', function () { go(1); });\n\n  rail.addEventListener('scroll', sync, { passive: true });\n  // Bei Resize aendert sich die Zahl der anfahrbaren Positionen, Striche neu bauen.\n  window.addEventListener('resize', function () { buildDots(); sync(); });\n  sync();\n\n  // Video: startet stumm per Nutzer-Gesture, Poster bleibt bis \"playing\" feuert\n  cards.forEach(function (card) {\n    if (!card.hasAttribute('data-mm-tst-video')) return;\n    var video = card.querySelector('video');\n    var btn = card.querySelector('.mm-tst-play');\n    if (!video || !btn) return;\n    // Quelle erst beim ersten Klick setzen. Mit src im Markup hat Chrome trotz\n    // preload=\"metadata\" beide Dateien komplett geladen: 12,9 MB und 7,2 MB.\n    // Der Ladebalken lief dadurch minutenlang weiter.\n    function ensureSrc() {\n      if (!video.getAttribute('src') && video.dataset.src) video.src = video.dataset.src;\n    }\n    btn.addEventListener('click', function () {\n      // andere laufende Videos anhalten\n      cards.forEach(function (other) {\n        if (other === card) return;\n        var v = other.querySelector('video');\n        if (v && !v.paused) { v.pause(); other.classList.remove('is-playing'); }\n      });\n      ensureSrc();\n      var p = video.play();\n      if (p && p.catch) p.catch(function () {});\n    });\n    // Klick auf die Videoflaeche haelt an bzw. laesst weiterlaufen\n    video.addEventListener('click', function () {\n      if (video.paused) {\n        ensureSrc();\n        var r = video.play();\n        if (r && r.catch) r.catch(function () {});\n      } else {\n        video.pause();\n      }\n    });\n    video.addEventListener('playing', function () {\n      card.classList.add('is-playing');\n      video.controls = true;\n    });\n  });\n})();\n</script>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_studie_section": {
