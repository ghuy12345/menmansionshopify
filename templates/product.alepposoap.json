          "type": "custom_liquid",
          "name": "MM PDP Redesign - Trust-Chips",
          "settings": {
            "custom_liquid": "<div class=\"mm-pdp-trust-chips\">\n  <span class=\"mm-pdp-trust-chip\"><span class=\"mm-pdp-trust-chip-dot\"></span>100% Natürlich</span>\n  <span class=\"mm-pdp-trust-chip\"><span class=\"mm-pdp-trust-chip-dot\"></span>Handgemacht</span>\n  <span class=\"mm-pdp-trust-chip\"><span class=\"mm-pdp-trust-chip-dot\"></span>Made in Germany</span>\n</div>"
          }
        },
