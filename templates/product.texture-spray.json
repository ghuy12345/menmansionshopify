      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-split\">\n  <div class=\"mm-pdp-split-col\">\n  </div>\n  <div class=\"mm-pdp-split-col\">\n<div class=\"mm-pdp-compare\">\n  \n  <h2 class=\"mm-pdp-compare-title\">Men Mansion vs.<br>andere Marken</h2>\n  <div class=\"mm-pdp-compare-table\">\n    <div class=\"mm-pdp-compare-row mm-pdp-compare-head\">\n      <span class=\"mm-pdp-compare-head-why\"><span class=\"mm-pdp-compare-why-label\">Warum</span>{%- if settings.logo != blank -%}<img class=\"mm-pdp-compare-logo\" src=\"{{ settings.logo | image_url: width: 300 }}\" alt=\"{{ shop.name }}\" loading=\"lazy\">{%- else -%}<span class=\"mm-pdp-compare-why-name\">Men Mansion</span>{%- endif -%}</span>\n      <span class=\"mm-pdp-compare-head-mm\"><span class=\"mm-pdp-compare-thumb\"><img src=\"{{ 'mm-tallow-tiegel.png' | asset_url }}\" alt=\"Men Mansion Tallow Gesichtscreme\" loading=\"lazy\" width=\"46\" height=\"46\"></span></span>\n      <span class=\"mm-pdp-compare-head-other\"><span class=\"mm-pdp-compare-thumb\"><img src=\"{{ 'mm-andere-tiegel.png' | asset_url }}\" alt=\"Andere Marken\" loading=\"lazy\" width=\"46\" height=\"46\"></span></span>\n    </div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Handgefertigt in kleinen Chargen</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Natürliche Wirkstoffe</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Enthält Silikone &amp; Mineralöl</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Eigene Manufaktur, keine Massenware</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Sichtbare Ergebnisse nach wenigen Tagen</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Künstliche Duft- &amp; Farbstoffe</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n  </div>\n</div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_reviews_header_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign rating = product.metafields.loox.avg_rating\n  assign review_count = product.metafields.loox.num_reviews\n  if rating != blank\n    assign rating_display = rating | replace: '.', ','\n    assign rounded = rating | round\n  else\n    assign rating_display = '4,8'\n    assign review_count = 398\n    assign rounded = 5\n  endif\n-%}\n<div class=\"mm-pdp-reviews\">\n  <div class=\"mm-pdp-reviews-head\">\n    <div>\n      \n      <h2 class=\"mm-pdp-reviews-title\">Was Männer über uns sagen</h2>\n    </div>\n    <div class=\"mm-pdp-reviews-summary\">\n      <span class=\"mm-pdp-reviews-avg\">{{ rating_display }}</span>\n      <div class=\"mm-pdp-reviews-summary-body\">\n        <div class=\"mm-pdp-reviews-stars\">{% for i in (1..5) %}{% if i <= rounded %}★{% else %}<span style=\"color:var(--mm-graphite)\">★</span>{% endif %}{% endfor %}</div>\n        <div class=\"mm-pdp-reviews-total\">{{ review_count }} verifizierte Bewertungen</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"mm-pdp-reviews-more-head\">\n    \n    <span class=\"mm-pdp-reviews-swipe-hint\">Wischen →</span>\n  </div>\n\n  <div\n    class=\"mm-pdp-reviews-grid\"\n    data-mm-reviews-grid\n    data-product-id=\"{{ product.id }}\"\n    data-fallback-image=\"{{ product.featured_image | image_url: width: 400 }}\"\n    data-fallback-product-name=\"{{ product.title | escape }}\"\n  ></div>\n  <div class=\"mm-pdp-reviews-more-wrap\">\n    <button type=\"button\" class=\"mm-pdp-reviews-cta mm-pdp-reviews-more\" data-mm-reviews-more hidden>Mehr Bewertungen</button>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_principle_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-principle\">\n  \n  <h2 class=\"mm-pdp-principle-title\">Die Kraft <em>des Ozeans</em></h2>\n  <p class=\"mm-pdp-principle-sub\">Das 3-in-1 Sea Texture Spray vereint Volumen, Pflege und Wachstum.</p>\n\n<div class=\"mm-pdp-ba\" data-mm-ba>\n  <span class=\"mm-pdp-ba-label mm-pdp-ba-label--before\">Vorher</span>\n  <span class=\"mm-pdp-ba-label mm-pdp-ba-label--after\">Nachher</span>\n  <div class=\"mm-pdp-ba-after\" data-mm-ba-after>\n    <img src=\"https://menmansion.com/cdn/shop/files/L1007653.jpg?v=1764269009&width=900\" alt=\"Nachher: Haar mit Sea Texture Spray gestylt\" draggable=\"false\">\n  </div>\n  <div class=\"mm-pdp-ba-before\" data-mm-ba-before>\n    <img src=\"https://menmansion.com/cdn/shop/files/L1007650.jpg?v=1764268972&width=900\" alt=\"Vorher: Haar ohne Styling\" draggable=\"false\">\n  </div>\n  <div class=\"mm-pdp-ba-handle\" data-mm-ba-handle>\n    <span class=\"mm-pdp-ba-handle-grip\">↔</span>\n  </div>\n</div>\n\n  <div class=\"mm-pdp-principle-grid\">\n    <div class=\"mm-pdp-principle-card\">\n      <svg class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M5 20c8 0 14-6 14-14 0-1 0-2-.5-3C12 4 5 10 5 18v2z\"></path></svg>\n      <h4 class=\"mm-pdp-principle-card-title\">100% natürliche Inhaltsstoffe</h4>\n      <p class=\"mm-pdp-principle-card-text\">Frei von Alkohol und künstlichen Duftstoffen.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <svg class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2c3 4 6 7 6 11a6 6 0 1 1-12 0c0-4 3-7 6-11z\"></path></svg>\n      <h4 class=\"mm-pdp-principle-card-title\">Die perfekte Formel</h4>\n      <p class=\"mm-pdp-principle-card-text\">Natürliche Meersalz-Formel mit Rosmarin, Aloe Vera und Zedernholzöl.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <svg class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M3 12c2-3 4 3 6 0s4 3 6 0 4 3 6 0\"></path></svg>\n      <h4 class=\"mm-pdp-principle-card-title\">Struktur-Effekt</h4>\n      <p class=\"mm-pdp-principle-card-text\">Natürliches Meersalz verleiht dem Haar sofort Griffigkeit und sichtbare Textur.</p>\n    </div>\n    <div class=\"mm-pdp-principle-card\">\n      <svg class=\"mm-pdp-principle-icon\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg>\n      <h4 class=\"mm-pdp-principle-card-title\">Leichter Halt</h4>\n      <p class=\"mm-pdp-principle-card-text\">Bringt Form ins Haar, ohne zu verkleben oder zu beschweren.</p>\n    </div>\n  </div>\n\n<div class=\"mm-pdp-ingredients-inline\">\n  \n  <h3 class=\"mm-pdp-ingredients-title\">Die Magie dahinter</h3>\n  <div class=\"mm-pdp-ingredients-grid\">\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/1_fb1f2171-e20f-413d-b75e-badd3ee7d1f2.png?v=1766160359&width=300\" alt=\"Meersalz\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Meersalz</h4>\n        <p class=\"mm-pdp-ingredient-text\">Sorgt für natürliche Griffigkeit und sichtbare Textur.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/2_6324b5c1-9c41-42ba-b00b-c09fe882c992.png?v=1766160359&width=300\" alt=\"Rosmarin\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Rosmarin</h4>\n        <p class=\"mm-pdp-ingredient-text\">Regt die Kopfhaut an und wirkt vitalisierend.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/3_f49643de-f20f-4c55-a99b-9765807c98ae.png?v=1766160358&width=300\" alt=\"Aloe Vera\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Aloe Vera</h4>\n        <p class=\"mm-pdp-ingredient-text\">Spendet Feuchtigkeit und beruhigt Haut &amp; Haar.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/4_d3029bef-c1b3-43be-9c31-603c6282141f.png?v=1766160359&width=300\" alt=\"Rizinusöl\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Rizinusöl</h4>\n        <p class=\"mm-pdp-ingredient-text\">Pflegt die Kopfhaut und stärkt die Haarstruktur.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/5_d9cee4f1-395c-40ae-9ddf-d7eef9702fa1.png?v=1766160359&width=300\" alt=\"Zedernholzöl\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Zedernholzöl</h4>\n        <p class=\"mm-pdp-ingredient-text\">Verleiht einen dezenten, natürlichen Duft und wirkt ausgleichend.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-ingredient-card\">\n      <img class=\"mm-pdp-ingredient-img\" src=\"https://menmansion.com/cdn/shop/files/6_2d4dc4a8-f03e-45f4-bbdc-3dac86322730.png?v=1766160359&width=300\" alt=\"Zitronenöl\">\n      <div class=\"mm-pdp-ingredient-body\">\n        <h4 class=\"mm-pdp-ingredient-title\">Zitronenöl</h4>\n        <p class=\"mm-pdp-ingredient-text\">Verleiht dem Haar einen frischen, zitrischen Duft und sorgt für ein sauberes, belebtes Finish.</p>\n      </div>\n    </div>\n  </div>\n</div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_faq_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-faq\">\n  \n  <h2 class=\"mm-pdp-faq-title\">Deine Fragen. Unsere Antworten.</h2>\n  <div class=\"mm-pdp-accordion\">\n    <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n      <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n        <span class=\"mm-pdp-accordion-label\">Für welchen Look eignet sich das Spray?</span>\n        <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n      </div>\n      <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n        <p>Das 3-in-1 Sea Texture Spray verleiht deinem Haar Struktur, Griff und Leichtigkeit für einen natürlichen, authentischen Look - ganz ohne steifen oder verklebten Eindruck.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n      <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n        <span class=\"mm-pdp-accordion-label\">Welche Inhaltsstoffe sind enthalten?</span>\n        <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n      </div>\n      <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n        <p>Meersalz für Struktur, Rosmarin-Hydrolat für die Kopfhaut, Aloe Vera zur Feuchtigkeitsspende und Rizinusöl zur Pflege. Ohne Alkohol und künstliche Duftstoffe, handgemacht in Deutschland.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n      <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n        <span class=\"mm-pdp-accordion-label\">Wie wende ich das Spray an?</span>\n        <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n      </div>\n      <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n        <p>Auf handtuchtrockenes oder trockenes Haar sprühen und mit den Fingern einarbeiten, um Struktur und Volumen zu formen. Für einen dezenteren Look weniger, für mehr Griffigkeit mehr aufsprühen.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n      <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n        <span class=\"mm-pdp-accordion-label\">Wie lange dauert der Versand?</span>\n        <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n      </div>\n      <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n        <p>Versand aus unserem Lager in Rottenburg, Deutschland - innerhalb von 1–2 Werktagen nach Auftragseingang. Lieferzeit in Deutschland, Österreich und der Schweiz: 2–4 Werktage. Kostenloser Versand ab 60 € Bestellwert.</p>\n      </div>\n    </div>\n    <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n      <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n        <span class=\"mm-pdp-accordion-label\">Was, wenn mir das Produkt nicht gefällt?</span>\n        <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n      </div>\n      <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n        <p>Du hast 30 Tage Zeit, das Produkt zurückzuschicken - ohne Wenn und Aber. Das ist unser Versprechen.</p>\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_sticky_cta_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{{ 'mm-pdp-sticky-cta.css' | asset_url | stylesheet_tag }}\n{%- liquid\n  assign sc_variant = product.selected_or_first_available_variant\n  assign sc_price = sc_variant.price\n  assign sc_compare = sc_variant.compare_at_price\n-%}\n<div class=\"mm-sc\" id=\"mm-sc\" aria-hidden=\"true\">\n  <div class=\"mm-sc-info\">\n    <span class=\"mm-sc-title\">{{ product.title }}</span>\n    <span class=\"mm-sc-prices\">\n      <span class=\"mm-sc-price\">{{ sc_price | money_without_currency }} €</span>\n      {%- if sc_compare > sc_price -%}\n        <span class=\"mm-sc-compare\">{{ sc_compare | money_without_currency }} €</span>\n      {%- endif -%}\n    </span>\n  </div>\n  <button type=\"button\" class=\"mm-btn mm-btn--primary mm-sc-cta\" id=\"mm-sc-cta\">Bundle wählen</button>\n</div>\n\n<script>\n(function () {\n  var bar = document.getElementById('mm-sc');\n  // In der Theme-Vorschau liegt die Shopify-Leiste unten drueber und verdeckt die\n  // Sticky-Bar komplett. Nur dort nach oben versetzen, auf dem Shop bleibt sie unten.\n  if (bar && /shopifypreview\\.com$/.test(location.hostname)) bar.classList.add('is-preview');\n  var cta = document.getElementById('mm-sc-cta');\n  if (!bar || !cta) return;\n\n  // Ab hier soll die Leiste erscheinen: die Vorher/Nachher-Section.\n  var trigger = document.querySelector('.mm-pdp-ba') || document.querySelector('.mm-pdp-principle');\n  // Ziel des Klicks: die Bundle-Auswahl in der Buybox (Koala-Widget),\n  // ersatzweise der Kaufbereich.\n  function target() {\n    return document.querySelector('koala-quantity-breaks-embed')\n      || document.querySelector('koala-quantity-breaks-app-block')\n      || document.querySelector('.koala-deal')\n      || document.querySelector('.product-form__buttons')\n      || document.querySelector('.product__info-container');\n  }\n\n  var ticking = false;\n  function sync() {\n    ticking = false;\n    if (!trigger) return;\n    var show = trigger.getBoundingClientRect().top < window.innerHeight * 0.6;\n    bar.classList.toggle('is-visible', show);\n    bar.setAttribute('aria-hidden', show ? 'false' : 'true');\n  }\n  function onScroll() {\n    if (ticking) return;\n    ticking = true;\n    window.requestAnimationFrame(sync);\n  }\n\n  cta.addEventListener('click', function () {\n    var el = target();\n    if (!el) return;\n    var header = document.querySelector('.section-header, sticky-header, header');\n    var offset = header ? header.getBoundingClientRect().height + 12 : 12;\n    var y = el.getBoundingClientRect().top + window.pageYOffset - offset;\n    window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });\n  });\n\n  window.addEventListener('scroll', onScroll, { passive: true });\n  window.addEventListener('resize', onScroll);\n  sync();\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "main",
    "mm_pdp_principle_section",
    "mm_pdp_why_mm_section",
    "mm_pdp_reviews_header_section",
    "mm_pdp_faq_section",
    "45f77b37-82dc-4dcd-aab6-662315b32360",
    "related-products",
    "mm_pdp_sticky_cta_section"
  ]
}