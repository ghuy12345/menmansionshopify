          "name": "MM PDP Redesign - Lieferzeile (dynamisch)",
          "settings": {
            "custom_liquid": "<div class=\"mm-pdp-delivery-pill\">\n  <span class=\"mm-pdp-delivery-date\"><span class=\"mm-pdp-delivery-dot\"></span><span data-mm-delivery-date>Lieferung in 1–3 Werktagen</span></span>\n  <span class=\"mm-pdp-delivery-ship\">🇩🇪 Kostenloser Versand ab 60 €</span>\n</div>\n<script>\n(function(){\n  var el = document.currentScript.previousElementSibling.querySelector(\"[data-mm-delivery-date]\");\n  if (!el) return;\n  var days = 3, added = 0, d = new Date();\n  while (added < days) {\n    d.setDate(d.getDate() + 1);\n    if (d.getDay() !== 0 && d.getDay() !== 6) added++;\n  }\n  var weekdays = [\"So.\",\"Mo.\",\"Di.\",\"Mi.\",\"Do.\",\"Fr.\",\"Sa.\"];\n  var months = [\"Jan\",\"Feb\",\"Mär\",\"Apr\",\"Mai\",\"Jun\",\"Jul\",\"Aug\",\"Sep\",\"Okt\",\"Nov\",\"Dez\"];\n  el.textContent = \"Lieferung am \" + weekdays[d.getDay()] + \", \" + d.getDate() + \". \" + months[d.getMonth()];\n})();\n</script>"
