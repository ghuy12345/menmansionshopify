        "mm_pdp_step2_tiers": {
          "type": "custom_liquid",
          "name": "MM PDP Redesign - Schritt 2 Mengen (hidden bis Freigabe)",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- liquid\n  assign variant = product.selected_or_first_available_variant\n  assign breaks = variant.quantity_price_breaks | sort: 'quantity'\n-%}\n<div class=\"mm-pdp-step-head\"><span></span></div>\n<div class=\"mm-pdp-tiers\" data-mm-tier-group data-section-id=\"{{ section.id }}\">\n  <button type=\"button\" class=\"mm-pdp-tier\" data-mm-tier data-quantity=\"1\" aria-pressed=\"true\">\n    <span class=\"mm-pdp-tier-radio\"></span>\n    <span class=\"mm-pdp-tier-body\">\n      <span class=\"mm-pdp-tier-name-row\"><span class=\"mm-pdp-tier-name\">1× Set</span></span>\n      <span class=\"mm-pdp-tier-sub\">Für den Einstieg</span>\n    </span>\n    <span class=\"mm-pdp-tier-price\"><span class=\"mm-pdp-tier-total\">{{ variant.price | money }}</span></span>\n  </button>\n  {%- for price_break in breaks -%}\n  {%- assign break_total = price_break.price | times: price_break.quantity -%}\n  {%- assign compare_total = variant.price | times: price_break.quantity -%}\n  <button type=\"button\" class=\"mm-pdp-tier\" data-mm-tier data-quantity=\"{{ price_break.quantity }}\" aria-pressed=\"false\">\n    <span class=\"mm-pdp-tier-radio\"></span>\n    <span class=\"mm-pdp-tier-body\">\n      <span class=\"mm-pdp-tier-name-row\">\n        <span class=\"mm-pdp-tier-name\">{{ price_break.quantity }}er Vorrat</span>\n        <span class=\"mm-pdp-tier-save\">Spare {{ compare_total | minus: break_total | money }}</span>\n      </span>\n      <span class=\"mm-pdp-tier-sub\">Mengenvorteil</span>\n    </span>\n    <span class=\"mm-pdp-tier-price\">\n      <span class=\"mm-pdp-tier-total\">{{ break_total | money }}</span>\n      <span class=\"mm-pdp-tier-compare\">{{ compare_total | money }}</span>\n    </span>\n  </button>\n  {%- endfor -%}\n</div>"
          }
        },
        "mm_pdp_description": {
          "type": "custom_liquid",
          "name": "MM PDP Redesign - Description",
          "settings": {
            "custom_liquid": "<p style=\"font-size: 13px; font-weight: 300; color: #FAFAF8; font-family: var(--font-body); line-height: 1.6; margin: 0; padding: 12px 0 8px;\">\nNatürliche Textur und spürbares Volumen. Meersalz, Rosmarin-Hydrolat und Aloe Vera für ein definiertes, gepflegtes Haarbild - ohne zu beschweren.\n</p>"
          }
        },
        "mm_pdp_trust_bullets": {
          "type": "custom_liquid",
          "name": "MM PDP Redesign - Trust-Bullets (Haken-Icon)",
          "settings": {
            "custom_liquid": "<div class=\"mm-pdp-trust-bullets\">\n  <span class=\"mm-pdp-trust-bullet\"><span class=\"mm-pdp-trust-check\">✓</span>Struktur, Griff und Volumen ohne Beschweren</span>\n  <span class=\"mm-pdp-trust-bullet\"><span class=\"mm-pdp-trust-check\">✓</span>Natürliches Meersalz statt synthetischer Zusätze</span>\n  <span class=\"mm-pdp-trust-bullet\"><span class=\"mm-pdp-trust-check\">✓</span>Ohne Alkohol und künstliche Duftstoffe</span>\n</div>"
          }
        },
        "mm_pdp_details_accordion": {
          "type": "custom_liquid",
          "name": "MM PDP Redesign - Produktdetails Akkordeon",
          "settings": {
            "custom_liquid": "<div class=\"mm-pdp-accordion\">\n  <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n    <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n      <span class=\"mm-pdp-accordion-label\">Beschreibung</span>\n      <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n    </div>\n    <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n      <p>Natürliche Textur und spürbares Volumen für ein definiertes, gepflegtes Haarbild.</p>\n      <p>Das Men Mansion Sea Texture Spray verleiht dem Haar Struktur, Griff und Leichtigkeit, ohne es zu beschweren oder steif wirken zu lassen. Die leichte Formulierung sorgt für ein natürliches Finish und unterstützt einen kontrollierten, markanten Look.</p>\n      <p>Natürliches Meersalz gibt dem Haar Volumen und Struktur, während pflegende Öle das Haar geschmeidig halten und ein Austrocknen vermeiden.</p>\n      <p>Ohne Alkohol und künstliche Duftstoffe. Handgemacht in Deutschland.</p>\n    </div>\n  </div>\n  <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n    <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n      <span class=\"mm-pdp-accordion-label\">Inhaltsstoffe &amp; Wirkung</span>\n      <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n    </div>\n    <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n      <p><strong>Destilliertes Wasser</strong><br>Dient als Basis der Formulierung und sorgt für eine leichte, gleichmäßige Verteilung im Haar.</p>\n      <p><strong>Meersalz</strong><br>Verleiht dem Haar spürbare Textur, mehr Griff und natürliches Volumen, ohne zu beschweren.</p>\n      <p><strong>Aloe Vera</strong><br>Wirkt feuchtigkeitsspendend und beruhigend, unterstützt die Kopfhautpflege und beugt Trockenheit vor.</p>\n      <p><strong>Rizinusöl</strong><br>Pflegt Haar und Kopfhaut, unterstützt die Haarstruktur.</p>\n      <p>INCI: Aqua, Maris Sal, Rosmarinus Officinalis Leaf Water, Aloe Barbadensis Leaf Juice, Ricinus Communis Seed Oil, Cedrus Atlantica Wood Oil, Citrus Limon Peel Oil</p>\n    </div>\n  </div>\n  <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n    <div class=\"mm-pdp-accordion-head\" data-mm-scroll-to=\"#mm-pdp-routine-anchor\">\n      <span class=\"mm-pdp-accordion-label\">Anwendung</span>\n      <span class=\"mm-pdp-accordion-scroll-hint\"><span class=\"mm-pdp-accordion-scroll-label\">Zur Routine</span><span class=\"mm-pdp-accordion-arrow\">↓</span></span>\n    </div>\n  </div>\n  <div class=\"mm-pdp-accordion-row\" data-mm-accordion>\n    <div class=\"mm-pdp-accordion-head\" data-mm-accordion-toggle>\n      <span class=\"mm-pdp-accordion-label\">Versand &amp; Rückgabe</span>\n      <span class=\"mm-pdp-accordion-mark\" data-mm-accordion-mark>+</span>\n    </div>\n    <div class=\"mm-pdp-accordion-body\" data-mm-accordion-body hidden>\n      <p><strong>Versand aus Deutschland. Schnell und zuverlässig.</strong></p>\n      <p>Alle Bestellungen werden aus unserem Lager in Rottenburg versendet – innerhalb von 1–2 Werktagen nach Auftragseingang.</p>\n      <p><strong>Lieferzeit:</strong><br>Deutschland, Österreich, Schweiz - 2–4 Werktage</p>\n      <p><strong>Kostenloser Versand</strong> ab €60 Bestellwert.</p>\n      <p>Nicht zufrieden? Kein Problem. Du hast 30 Tage Zeit, das Produkt zurückzuschicken – ohne Wenn und Aber.</p>\n    </div>\n  </div>\n</div>"
          }
        },
