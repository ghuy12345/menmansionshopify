        "ggl0TtviMUV_text": "<p><span style=\"color:#AF9841;font-size:20px;\"><strong>100% natürliche Inhaltsstoffe</strong></span></p>",
        "ggGFjr27emr_text": "<p><span style=\"color:rgb(255,255,255);font-size:medium;\">Premium-Rindertalg mit Schwarzkümmelöl, Traubenkernöl, Zedernholzöl und Bienenwachs – in Duft, Wirkung und Konsistenz veredelt.</span></p>",
        "gg9F-bEbcM9_text": "<p><span style=\"color:#AF9841;font-size:21px;\"><strong>Edler, maskuliner Duft.</strong></span></p>",
        "ggx_6Z_bYxE_text": "<p><span style=\"color:rgb(255,255,255);font-size:medium;\">Zedernholzöl v</span><span style=\"background-color:rgb(25,25,25);color:rgb(250,250,250);font-size:17px;\">erleiht der Creme einen edlen, leicht holzigen Duft und sorgt für ein angenehmes Gefühl.</span></p>"
      }
    },
