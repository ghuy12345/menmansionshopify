        "checksum": "a205faded8d667e32630f137541bb69ea30e06f4f5764b7a0166c87526141293_1_1_1_0__1",
        "ggpFtnrAJon_text": "<p>Wissenschaftlich belegt. Seit Jahrtausenden bewährt.</p>",
        "ggCNujeOWUA_text": "<p><span style=\"color:#AF9841;font-size:20px;\"><strong>Premium-Rindertalg</strong></span></p>",
