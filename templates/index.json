        "custom_liquid": "{{ 'mm-home-tallow.css' | asset_url | stylesheet_tag }}\n<script src=\"{{ 'mm-home-tallow.js' | asset_url }}\" defer=\"defer\"></script>\n<section class=\"mm-tallow\">\n  <div class=\"mm-tallow-head\">\n    <h2 class=\"mm-tallow-title\">„Die beste Gesichtscreme der Welt!\"</h2>\n    <p class=\"mm-tallow-lead\">Der 100 % natürliche Gesichtsbalm der alten Römer - für sichtbar gesunde und makellose Haut.</p>\n  </div>\n\n  <div class=\"mm-tallow-grid\">\n    <div class=\"mm-tallow-media\">\n      <img src=\"https://menmansion.com/cdn/shop/files/L1007643.jpg?v=1776242371&width=1200\" alt=\"Tallow Gesichtscreme in der Hand\" loading=\"lazy\" width=\"1200\" height=\"1200\">\n    </div>\n    <div class=\"mm-tallow-content\">\n      <div class=\"mm-tallow-rating\"><span class=\"mm-tallow-rating-stars\">★★★★★</span><span>4,9 · 1.435 Bewertungen</span></div>\n      <h3 class=\"mm-tallow-name\">Tallow Gesichtscreme™ 50ml</h3>\n      <p class=\"mm-tallow-sub\">Premium Rindertalg, veredelt mit ausgewählten Naturölen. Mehr braucht deine Haut nicht.</p>\n      <div class=\"mm-tallow-usps\">\n        <div class=\"mm-tallow-usp\"><span class=\"mm-tallow-usp-check\">✓</span><span>Sichtbare Ergebnisse nach wenigen&nbsp;Anwendungen</span></div>\n        <div class=\"mm-tallow-usp\"><span class=\"mm-tallow-usp-check\">✓</span><span>Zieht schnell ein, ohne Fettfilm</span></div>\n        <div class=\"mm-tallow-usp\"><span class=\"mm-tallow-usp-check\">✓</span><span>Grasgefüttertes Beef Tallow</span></div>\n      </div>\n      <a href=\"/products/tallow-gesichtscreme-y-50ml\" class=\"mm-tallow-cta\" data-variant-id=\"52607180013910\">Mehr erfahren</a>\n      <div class=\"mm-tallow-stock\"><span class=\"mm-tallow-stock-dot\"></span><span>Auf Lager - Versand innerhalb von 1–2 Werktagen</span></div>\n          </div>\n  </div>\n\n  <div class=\"mm-tallow-sticky\" data-mm-tallow-sticky>\n    <div class=\"mm-tallow-sticky-info\">\n      <span class=\"mm-tallow-sticky-name\">Tallow Gesichtscreme™ 50ml</span>\n      <span class=\"mm-tallow-sticky-price\">39,90 €</span>\n    </div>\n    <a href=\"/products/tallow-gesichtscreme-y-50ml\" class=\"mm-tallow-sticky-cta\" data-variant-id=\"52607180013910\">Mehr erfahren</a>\n  </div>\n</section>",
