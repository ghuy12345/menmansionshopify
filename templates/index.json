      "name": "MM Home - Magazin-Rail",
      "settings": {
        "custom_liquid": "{{ 'mm-home-magazin.css' | asset_url | stylesheet_tag }}\n<section class=\"mm mm-mag\">\n  <div class=\"mm-wrap\">\n\n    <div class=\"mm-maghead\">\n      <div>\n        \n        <h2 class=\"mm-h2\">Men Mansion Magazin</h2>\n      </div>\n      <a class=\"mm-all\" href=\"{{ blogs.news.url }}\">Alle Artikel\n        <svg width=\"14\" height=\"10\" viewBox=\"0 0 14 10\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 1l4 4-4 4M0 5h13\" stroke=\"currentColor\" stroke-width=\"1.3\"/></svg>\n      </a>\n    </div>\n\n    <div class=\"mm-rail\">\n      {%- for article in blogs.news.articles -%}\n        {%- liquid\n          assign mm_cat = 'Hautpflege'\n          if article.handle contains 'bartpflege-routine'\n            assign mm_cat = 'Bartpflege'\n          elsif article.handle contains 'sea-texture-spray'\n            assign mm_cat = 'Haarstyling'\n          endif\n        -%}\n        <a class=\"mm-card\" href=\"{{ article.url }}\">\n          <figure>\n            {%- if article.image -%}\n              <img src=\"{{ article.image | image_url: width: 800 }}\" alt=\"{{ article.title | escape }}\" loading=\"lazy\" width=\"800\" height=\"600\">\n            {%- endif -%}\n          </figure>\n          <div class=\"mm-cardbody\">\n            <span class=\"mm-cat\">{{ mm_cat }}</span>\n            <h3>{{ article.title }}</h3>\n          </div>\n        </a>\n      {%- endfor -%}\n    </div>\n\n  </div>\n</section>",
