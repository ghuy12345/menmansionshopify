    "mm_pdp_ingredients_section": {
      "type": "custom-liquid",
      "name": "MM Inhaltsstoffe (Raster)",
      "settings": {
        "custom_liquid": "{{ 'mm-pdp-ingredients-grid.css' | asset_url | stylesheet_tag }}\n<section class=\"mm-ig\">\n  <div class=\"mm-ig-inner\">\n\n    <header class=\"mm-ig-head\">\n      <h2 class=\"mm-ig-title\">Die Magie dahinter</h2>\n    </header>\n\n  <ul class=\"mm-ig-grid\">\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/35.jpg?v=1786099583&width=600\" alt=\"Tallow\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Tallow</h3>\n        <p class=\"mm-ig-benefit\">Enthält alle Nährstoffe und Vitamine die deine Haut benötigt.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/gemini-image-2_Create_a_cinematic_macro_scene_featuring_grape_seed_oil_as_the_central_ingredien-2_2.jpg?v=1786099586&width=600\" alt=\"Traubenkernöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Traubenkernöl</h3>\n        <p class=\"mm-ig-benefit\">Zieht leicht ein und sorgt für ein geschmeidiges Hautgefühl.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/Lucid_Realism_Hyperrealistic_macro_shot_of_black_cumin_oil_Nig_0_1.jpg?v=1786099587&width=600\" alt=\"Schwarzkümmelöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Schwarzkümmelöl</h3>\n        <p class=\"mm-ig-benefit\">Wirkt antibakteriell, stärkt die Haut und beruhigt Unreinheiten.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/IMG_0327.jpg?v=1786099586&width=600\" alt=\"Bienenwachs\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Bienenwachs</h3>\n        <p class=\"mm-ig-benefit\">Schützt die Haut und hält sie langanhaltend geschmeidig.</p>\n      </div>\n    </li>\n    <li class=\"mm-ig-card\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0779/4583/1766/files/ChatGPT_Image_10._Aug._2026_10_26_18.png?v=1786350395&width=600\" alt=\"Zedernholzöl\" loading=\"lazy\" width=\"600\" height=\"600\">\n      <span class=\"mm-ig-fade\"></span>\n      <div class=\"mm-ig-cap\">\n        <h3 class=\"mm-ig-name\">Zedernholzöl</h3>\n        <p class=\"mm-ig-benefit\">Verleiht der Creme ihren edlen, maskulinen Duft nach Zedernholz.</p>\n      </div>\n    </li>\n  </ul>\n\n  </div>\n</section>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_sticky_cta_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{{ 'mm-pdp-sticky-cta.css' | asset_url | stylesheet_tag }}\n{%- liquid\n  assign sc_variant = product.selected_or_first_available_variant\n  assign sc_price = sc_variant.price\n  assign sc_compare = sc_variant.compare_at_price\n-%}\n<div class=\"mm-sc\" id=\"mm-sc\" aria-hidden=\"true\">\n  <div class=\"mm-sc-info\">\n    <span class=\"mm-sc-title\">{{ product.title }}</span>\n    <span class=\"mm-sc-prices\">\n      <span class=\"mm-sc-price\">{{ sc_price | money_without_currency }} €</span>\n      {%- if sc_compare > sc_price -%}\n        <span class=\"mm-sc-compare\">{{ sc_compare | money_without_currency }} €</span>\n      {%- endif -%}\n    </span>\n  </div>\n  <button type=\"button\" class=\"mm-btn mm-btn--primary mm-sc-cta\" id=\"mm-sc-cta\">Bundle wählen</button>\n</div>\n\n<script>\n(function () {\n  var bar = document.getElementById('mm-sc');\n  // In der Theme-Vorschau liegt die Shopify-Leiste unten drueber und verdeckt die\n  // Sticky-Bar komplett. Nur dort nach oben versetzen, auf dem Shop bleibt sie unten.\n  if (bar && /shopifypreview\\.com$/.test(location.hostname)) bar.classList.add('is-preview');\n  var cta = document.getElementById('mm-sc-cta');\n  if (!bar || !cta) return;\n\n  // Ab hier soll die Leiste erscheinen: die Vorher/Nachher-Section.\n  var trigger = document.querySelector('.mm-pdp-ba') || document.querySelector('.mm-pdp-principle');\n  // Ziel des Klicks: die Bundle-Auswahl in der Buybox (Koala-Widget),\n  // ersatzweise der Kaufbereich.\n  function target() {\n    return document.querySelector('koala-quantity-breaks-embed')\n      || document.querySelector('koala-quantity-breaks-app-block')\n      || document.querySelector('.koala-deal')\n      || document.querySelector('.product-form__buttons')\n      || document.querySelector('.product__info-container');\n  }\n\n  var ticking = false;\n  function sync() {\n    ticking = false;\n    if (!trigger) return;\n    var show = trigger.getBoundingClientRect().top < window.innerHeight * 0.6;\n    bar.classList.toggle('is-visible', show);\n    bar.setAttribute('aria-hidden', show ? 'false' : 'true');\n  }\n  function onScroll() {\n    if (ticking) return;\n    ticking = true;\n    window.requestAnimationFrame(sync);\n  }\n\n  cta.addEventListener('click', function () {\n    var el = target();\n    if (!el) return;\n    var header = document.querySelector('.section-header, sticky-header, header');\n    var offset = header ? header.getBoundingClientRect().height + 12 : 12;\n    var y = el.getBoundingClientRect().top + window.pageYOffset - offset;\n    window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });\n  });\n\n  window.addEventListener('scroll', onScroll, { passive: true });\n  window.addEventListener('resize', onScroll);\n  sync();\n})();\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
