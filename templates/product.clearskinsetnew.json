    "mm_pdp_reviews_header_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign rating = product.metafields.loox.avg_rating\n  assign review_count = product.metafields.loox.num_reviews\n  if rating != blank\n    assign rating_display = rating | replace: '.', ','\n    assign rounded = rating | round\n  else\n    assign rating_display = '4,8'\n    assign review_count = 398\n    assign rounded = 5\n  endif\n-%}\n<div class=\"mm-pdp-reviews\">\n  <div class=\"mm-pdp-reviews-head\">\n    <div>\n      \n      <h2 class=\"mm-pdp-reviews-title\">Was Männer über uns sagen</h2>\n    </div>\n    <div class=\"mm-pdp-reviews-summary\">\n      <span class=\"mm-pdp-reviews-avg\">{{ rating_display }}</span>\n      <div class=\"mm-pdp-reviews-summary-body\">\n        <div class=\"mm-pdp-reviews-stars\">{% for i in (1..5) %}{% if i <= rounded %}★{% else %}<span style=\"color:var(--mm-graphite)\">★</span>{% endif %}{% endfor %}</div>\n        <div class=\"mm-pdp-reviews-total\">{{ review_count }} verifizierte Bewertungen</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"mm-pdp-reviews-spotlight\">\n    <span class=\"mm-pdp-reviews-badge\">Top-Bewertung</span>\n    <div class=\"mm-pdp-reviews-spotlight-body\">\n      <div class=\"mm-pdp-reviews-stars\">★★★★★</div>\n      <div class=\"mm-pdp-reviews-spotlight-quote\">„Endlich eine cleane Haut“</div>\n      <p class=\"mm-pdp-reviews-spotlight-text\">Das einzige was mir wirklich eine cleane Haut gebracht hat, ist das Beef Tallow von Men Mansion!</p>\n      <div class=\"mm-pdp-reviews-author\">\n        <span class=\"mm-pdp-reviews-avatar\">J</span>\n        <div>\n          <div class=\"mm-pdp-reviews-author-name\">Justus <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"var(--mm-gold-soft)\"></circle><path d=\"M7 12.5l3 3 7-7\" fill=\"none\" stroke=\"var(--mm-onyx)\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div>\n          <div class=\"mm-pdp-reviews-author-meta\">Verifiziert · Clear Skin Set</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"mm-pdp-reviews-more-head\">\n    \n    <span class=\"mm-pdp-reviews-swipe-hint\">Wischen →</span>\n  </div>\n\n  <div\n    class=\"mm-pdp-reviews-grid\"\n    data-mm-reviews-grid\n    data-product-id=\"{{ product.id }}\"\n    data-fallback-image=\"{{ product.featured_image | image_url: width: 400 }}\"\n    data-fallback-product-name=\"{{ product.title | escape }}\"\n  ></div>\n  <div class=\"mm-pdp-reviews-more-wrap\">\n    <button type=\"button\" class=\"mm-pdp-reviews-cta mm-pdp-reviews-more\" data-mm-reviews-more hidden>Mehr Bewertungen</button>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
