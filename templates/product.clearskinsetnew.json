    "mm_pdp_deepdives_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-deepdive-group\">\n  <div class=\"mm-pdp-deepdive\">\n    <img class=\"mm-pdp-deepdive-img\" src=\"https://menmansion.com/cdn/shop/files/tallow_6717dc4e-91c8-4004-9713-4f01e1b18f4b.png?v=1776688595&amp;width=1445\" alt=\"Tallow Gesichtscreme\">\n    <div class=\"mm-pdp-deepdive-body\">\n      \n      <h2 class=\"mm-pdp-deepdive-title\">Tallow Gesichtscreme</h2>\n      <p class=\"mm-pdp-deepdive-text\">Zieht vollständig ein und stärkt spürbar die Hautbarriere.</p>\n      <div class=\"mm-pdp-deepdive-checks\">\n        <span><span class=\"mm-pdp-check\">✓</span>Stärkt die Hautbarriere</span>\n        <span><span class=\"mm-pdp-check\">✓</span>Beruhigt und nährt - ohne Fettfilm</span>\n        <span><span class=\"mm-pdp-check\">✓</span>Zieht vollständig ein</span>\n      </div>\n    </div>\n  </div>\n  <div class=\"mm-pdp-deepdive\">\n    <img class=\"mm-pdp-deepdive-img\" src=\"https://menmansion.com/cdn/shop/files/menmansion-verlauf-gold-aleppo.png?v=1776688595&amp;width=1445\" alt=\"Aleppo Seife\">\n    <div class=\"mm-pdp-deepdive-body\">\n      \n      <h2 class=\"mm-pdp-deepdive-title\">Aleppo Seife</h2>\n      <p class=\"mm-pdp-deepdive-text\">Traditionelle Reinigung, inspiriert von zeitlosen Traditionen - entfernt Schmutz und überschüssigen Talg, ohne die Haut auszutrocknen.</p>\n      <div class=\"mm-pdp-deepdive-checks\">\n        <span><span class=\"mm-pdp-check\">✓</span>Entfernt Schmutz und überschüssigen Talg</span>\n        <span><span class=\"mm-pdp-check\">✓</span>Naturreine Öle, keine synthetischen Tenside</span>\n        <span><span class=\"mm-pdp-check\">✓</span>Trocknet die Haut nicht aus</span>\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_studie_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-studie\">\n  \n  <h2 class=\"mm-pdp-studie-title\">Bewiesene Wirkung,<br><span class=\"mm-pdp-gold\">sichtbare Ergebnisse</span></h2>\n  <div class=\"mm-pdp-studie-stats\">\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">95%</div>\n      <div class=\"mm-pdp-studie-desc\">Sichtbare Ergebnisse bei regelmäßiger Anwendung</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">91%</div>\n      <div class=\"mm-pdp-studie-desc\">Berichten von einer spürbar einfacheren Morgenroutine</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n    <div class=\"mm-pdp-studie-stat\">\n      <div class=\"mm-pdp-studie-number\">97%</div>\n      <div class=\"mm-pdp-studie-desc\">Würden die Routine weiterempfehlen</div>\n      <div class=\"mm-pdp-studie-meta\">Ergebnisse einer 4-wöchigen Kundenstudie</div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_routine_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{{ 'mm-pdp-routine3.css' | asset_url | stylesheet_tag }}\n<section class=\"mm-r3\" id=\"mm-pdp-routine-anchor\">\n  <div class=\"mm-r3-inner\">\n\n    <header class=\"mm-r3-head\">\n      <h2 class=\"mm-r3-title\">Die Routine. <span>In 2 Steps.</span></h2>\n      <p class=\"mm-r3-sub\">Deine tägliche Routine - einfach, effektiv, natürlich</p>\n    </header>\n\n    <ol class=\"mm-r3-track\" id=\"mm-r3-track\">\n      <li class=\"mm-r3-card\">\n        <div class=\"mm-r3-media\">\n          <img src=\"https://menmansion.com/cdn/shop/files/IMG_1680.jpg?v=1775741337&amp;width=800\" alt=\"Reinigen\" loading=\"lazy\" width=\"800\" height=\"600\">\n          <span class=\"mm-r3-fade\"></span>\n          <span class=\"mm-r3-num\">01</span>\n        </div>\n        <div class=\"mm-r3-body\">\n          <div class=\"mm-r3-row\"><h3>Reinigen</h3></div>\n          <p>Reinige dein Gesicht mit der Aleppo-Seife und lauwarmem Wasser, um Schmutz und überschüssigen Talg zu entfernen.</p>\n        </div>\n      </li>\n      <li class=\"mm-r3-card\">\n        <div class=\"mm-r3-media\">\n          <img src=\"https://menmansion.com/cdn/shop/files/IMG_1502_3.jpg?v=1775510634&amp;width=800\" alt=\"Auftragen\" loading=\"lazy\" width=\"800\" height=\"600\">\n          <span class=\"mm-r3-fade\"></span>\n          <span class=\"mm-r3-num\">02</span>\n        </div>\n        <div class=\"mm-r3-body\">\n          <div class=\"mm-r3-row\"><h3>Auftragen</h3></div>\n          <p>Eine kleine Menge der Tallow Gesichtscreme auf das leicht feuchte Gesicht auftragen und einmassieren. Die hautähnlichen Lipide stärken die Hautbarriere und ziehen vollständig ein.</p>\n        </div>\n      </li>\n    </ol>\n\n    <div class=\"mm-r3-dots\" id=\"mm-r3-dots\" hidden>\n      <button type=\"button\" data-i=\"0\" aria-label=\"Schritt 1\"><span></span></button>\n      <button type=\"button\" data-i=\"1\" aria-label=\"Schritt 2\"><span></span></button>\n    </div>\n\n  </div>\n</section>\n\n<script>\n(function () {\n  var track = document.getElementById('mm-r3-track');\n  var dots  = document.getElementById('mm-r3-dots');\n  if (!track || !dots || !track.children.length) return;\n  var btns = dots.querySelectorAll('button');\n  function stepWidth() {\n    if (track.children.length > 1) return track.children[1].offsetLeft - track.children[0].offsetLeft;\n    return track.children[0].getBoundingClientRect().width;\n  }\n  function sync() {\n    var scrollable = track.scrollWidth - track.clientWidth > 8;\n    dots.hidden = !scrollable;\n    if (!scrollable) return;\n    var step = stepWidth();\n    if (!step) return;\n    var i = Math.min(btns.length - 1, Math.round(track.scrollLeft / step));\n    for (var n = 0; n < btns.length; n++) btns[n].setAttribute('aria-current', n === i ? 'true' : 'false');\n  }\n  for (var b = 0; b < btns.length; b++) {\n    btns[b].addEventListener('click', function () {\n      var el = track.children[+this.dataset.i];\n      if (el) track.scrollTo({ left: el.offsetLeft - track.offsetLeft, behavior: 'smooth' });\n    });\n  }\n  track.addEventListener('scroll', sync, { passive: true });\n  window.addEventListener('resize', sync);\n  sync();\n})();\n</script>",
        "color_scheme": "background-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "mm_pdp_comparison_section": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"mm-pdp-compare\">\n  \n  <h2 class=\"mm-pdp-compare-title\">Men Mansion vs.<br>andere Marken</h2>\n  <div class=\"mm-pdp-compare-table\">\n    <div class=\"mm-pdp-compare-row mm-pdp-compare-head\">\n      <span class=\"mm-pdp-compare-head-why\"><span class=\"mm-pdp-compare-why-label\">Warum</span>{%- if settings.logo != blank -%}<img class=\"mm-pdp-compare-logo\" src=\"{{ settings.logo | image_url: width: 300 }}\" alt=\"{{ shop.name }}\" loading=\"lazy\">{%- else -%}<span class=\"mm-pdp-compare-why-name\">Men Mansion</span>{%- endif -%}</span>\n      <span class=\"mm-pdp-compare-head-mm\"><span class=\"mm-pdp-compare-thumb\"><img src=\"{{ 'mm-tallow-tiegel.png' | asset_url }}\" alt=\"Men Mansion Tallow Gesichtscreme\" loading=\"lazy\" width=\"46\" height=\"46\"></span></span>\n      <span class=\"mm-pdp-compare-head-other\"><span class=\"mm-pdp-compare-thumb\"><img src=\"{{ 'mm-andere-tiegel.png' | asset_url }}\" alt=\"Andere Marken\" loading=\"lazy\" width=\"46\" height=\"46\"></span></span>\n    </div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Handgefertigt in kleinen Chargen</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Natürliche Wirkstoffe</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Enthält Silikone &amp; Mineralöl</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Eigene Manufaktur, keine Massenware</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Sichtbare Ergebnisse nach wenigen Tagen</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n    <div class=\"mm-pdp-compare-row\"><span class=\"mm-pdp-compare-label\">Künstliche Duft- &amp; Farbstoffe</span><span class=\"mm-pdp-compare-cell-us\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--no\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M4 4L12 12M12 4L4 12\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span><span class=\"mm-pdp-compare-cell-them\"><span class=\"mm-pdp-compare-badge mm-pdp-compare-badge--yes\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M3 8.5L6.5 12L13 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></span></div>\n  </div>\n</div>",
