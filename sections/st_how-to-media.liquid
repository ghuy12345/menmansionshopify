<script>

  // Initialize on Shopify section load (theme editor)
  document.addEventListener('shopify:section:load', function(event) {
    // Check if the loaded section is this specific section
    if (event.detail.sectionId === '{{ section.id }}') {
      initHowItWorksSwiper();
    }
  });

  // Reinitialize when section settings change in theme editor
  document.addEventListener('shopify:section:select', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initVideoControls();
    }
  });

  // Reinitialize when block settings change in theme editor
  document.addEventListener('shopify:block:select', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initVideoControls();
    }
  });

  // Initialize on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHowItWorksSwiper);
  } else {
    initHowItWorksSwiper();
  }

  function initHowItWorksSwiper() {
    {% if section.settings.mobile_layout == 'swiper' %}
      // Initialize Swiper only if mobile layout is set to swiper
      const swiperElement = document.querySelector('#howItWorksSwiper{{ section.id }}');

      // Check if swiper element exists and hasn't been initialized yet
      if (swiperElement && !swiperElement.swiper) {
        const swiper = new Swiper('#howItWorksSwiper{{ section.id }}', {
          slidesPerView: 'auto',
          spaceBetween: {{ section.settings.card_gap }},
          grabCursor: true,
          loop: false,
          initialSlide: 0,
          // Ensure left alignment
          centeredSlides: false,
          slideToClickedSlide: false,
          // Add proper spacing from container edges
          slidesOffsetBefore: 20,
          slidesOffsetAfter: 20,
        });
      }
    {% endif %}

    // Initialize video controls
    initVideoControls();
  }

  function initVideoControls() {
    const sectionId = '{{ section.id }}';
    const sectionWrapper = document.querySelector('.st_hiw-section-wrapper--' + sectionId);
    if (!sectionWrapper) return;

    // Lazy-load videos with IntersectionObserver — only load and play when visible
    var lazyVideos = sectionWrapper.querySelectorAll('video.st_hiw-lazy-video');

    if ('IntersectionObserver' in window) {
      var videoObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var video = entry.target;
            // Load sources if not yet loaded
            if (!video.dataset.loaded) {
              video.querySelectorAll('source[data-src]').forEach(function(source) {
                source.src = source.dataset.src;
                source.removeAttribute('data-src');
              });
              video.load();
              video.dataset.loaded = 'true';
            }
            video.muted = true;
            video.play().catch(function() {});
          } else {
            // Pause when out of view to save resources
            entry.target.pause();
          }
        });
      }, { rootMargin: '200px 0px' });

      lazyVideos.forEach(function(video) { videoObserver.observe(video); });
    } else {
      // Fallback: load all videos immediately
      lazyVideos.forEach(function(video) {
        video.querySelectorAll('source[data-src]').forEach(function(source) {
          source.src = source.dataset.src;
          source.removeAttribute('data-src');
        });
        video.load();
        video.muted = true;
        video.play().catch(function() {});
      });
    }

    // Update button icons to match initial muted state
    sectionWrapper.querySelectorAll('.st_hiw-mute-btn').forEach(function(btn) {
      var muteIcon = btn.querySelector('.st_hiw-mute-icon');
      var unmuteIcon = btn.querySelector('.st_hiw-unmute-icon');
      if (muteIcon && unmuteIcon) {
        muteIcon.style.display = 'block';
        unmuteIcon.style.display = 'none';
      }
    });

    // Remove existing event listeners by cloning and replacing buttons
    sectionWrapper.querySelectorAll('.st_hiw-mute-btn').forEach(function(btn) {
      var newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
    });

    // Handle mute/unmute buttons with fresh event listeners
    sectionWrapper.querySelectorAll('.st_hiw-mute-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var videoId = this.getAttribute('data-video-id');
        var video = sectionWrapper.querySelector('video[data-video-id="' + videoId + '"]');
        var muteIcon = this.querySelector('.st_hiw-mute-icon');
        var unmuteIcon = this.querySelector('.st_hiw-unmute-icon');

        if (video.muted) {
          video.muted = false;
          muteIcon.style.display = 'none';
          unmuteIcon.style.display = 'block';
        } else {
          video.muted = true;
          muteIcon.style.display = 'block';
          unmuteIcon.style.display = 'none';
        }
      });
    });
  }
</script>

