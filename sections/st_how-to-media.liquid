<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ section.settings.section_title | strip_html | replace: '[', '' | replace: ']', '' | json }},
  {% if section.settings.section_subtitle != blank %}
  "description": {{ section.settings.section_subtitle | json }},
  {% endif %}
  "step": [
    {%- for block in section.blocks -%}
    {
      "@type": "HowToStep",
      "position": {{ forloop.index }},
      "name": {{ block.settings.title | default: 'Step Title' | json }},
      "text": {{ block.settings.description | strip_html | default: '' | json }}
      {%- if block.settings.media_type == 'video' and block.settings.video != blank -%}
        {%- for source in block.settings.video.sources limit: 1 -%}
      ,"video": {
        "@type": "VideoObject",
        "contentUrl": {{ source.url | json }},
        "name": {{ block.settings.title | default: 'Step Video' | json }},
        "description": {{ block.settings.description | strip_html | default: '' | json }},
        "thumbnailUrl": {{ block.settings.video.preview_image | image_url: width: 800 | default: '' | json }},
        "uploadDate": {{ 'now' | date: '%Y-%m-%d' | json }}
      }
        {%- endfor -%}
      {%- elsif block.settings.image -%}
      ,"image": {{ block.settings.image | image_url: width: 800 | json }}
      {%- endif -%}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

