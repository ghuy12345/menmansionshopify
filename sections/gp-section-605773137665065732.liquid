      <style id="custom-css-gVwIBRbXS3">
        /* 1


Circle Progress Bar */

.pf-circle-container {
  width: 90px;
  height: 90px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Background Circle Color & Width */
.pf-bg-circle {
  stroke: #e6e6e6;
  /* পেছনের ধসর কালার */
  stroke-width: 10;
  /* মোটা বা চিকন করা */
}

/* Main Progress Bar Color & Width */
.pf-progress-bar {
  stroke: #AF9841;
  stroke-width: 10;
}

.pf-svg {
  background-color: transparent;
}

.pf-progress-text-mobile {
  position: absolute;
  z-index: 1;
  margin: 0;
  pointer-events: none;
  /* টেক্সটের ওপর ক্লিক পড়লেও যেন সমস্যা না হয় */
}

@font-face {
  font-family: "SuisseIntl-Bold";
  src: url("https://cdn.shopify.com/s/files/1/0802/2432/1778/files/Neue_Kabel_Bold_a61fc9ad-f57d-48da-bc66-fff085ca0a9e.woff2?v=1767123810") format("woff2");
  font-display: swap;
}

.pf-progress-text-mobile {
  font-family: "SuisseIntl-Bold", sans-serif !important;
  font-size: 24px !important;
  line-height: 130% !important;
  color: #FAFAF8;
}

/* Mobile */
@media (max-width: 767px) {
  .pf-progress-text-mobile {
    font-size: 20px !important;
    line-height: 130% !important;
  }
}

      </style>
    
      <script id="custom-js-gVwIBRbXS3">
        try {
          // 1 Circle Progress Bar

window.addEventListener('load', function () {
  setTimeout(() => {
    // সব এলিমেন্টকে একসাথে টার্গেট করছি
    const containers = document.querySelectorAll(".pf-circle-container");

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const container = entry.target;
          const progressCircle = container.querySelector(".pf-progress-bar");
          const textEl = container.querySelector(".pf-progress-text-mobile");

          if (!progressCircle || !textEl) return;

          // পারসেন্টেজ বের করা
          const targetPercent = parseInt(textEl.innerText) || 75;
          const circumference = 440;

          // ১. সার্কেল অ্যানিমেশন
          const offset = circumference - (targetPercent / 100) * circumference;
          progressCircle.style.strokeDashoffset = offset;

          // ২. নাম্বার কাউন্ট অ্যানিমেশন
          let startCount = 0;
          const duration = 1500; // ১.৫ সেকেন্ড
          const step = duration / targetPercent;

          const interval = setInterval(() => {
            startCount++;
            if (startCount > targetPercent) {
              clearInterval(interval);
            } else {
              textEl.innerText = startCount + "%";
            }
          }, step);

          observer.unobserve(container);
        }
      });
    }, { threshold: 0.2 });

    containers.forEach(c => observer.observe(c));
  }, 1000); // PageFly ফুল লোড হওয়ার জন্য ১ সেকেন্ড ওয়েট করা সেফ
});
        } catch(err){}
      </script>
    
